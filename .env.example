PORT=8000

ENVIRONMENT=DEVELOPMENT

JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRE=1h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRE=7d

DB_HOST=
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore
GEMINI_PROXY_URL=

# AssemblyAI API key used by the student assessment client.
ASSEMBLYAI_API_KEY=

CLICK_SERVICE_ID=
CLICK_SECRET_KEY=

# Payme (Paycom) Merchant API. The key signs the Basic auth header Payme sends
# ("Paycom:<key>"); if it is unset every Payme request is rejected with -32504.
PAYME_MERCHANT_KEY=
# Optional. Name of the account field configured in the Payme cabinet.
# Defaults to payment_id.
PAYME_ACCOUNT_FIELD=payment_id

ESKIZ_API_URL=https://notify.eskiz.uz/api
ESKIZ_API_USER=
ESKIZ_API_KEY=

# Resend email OTP transport. RESEND_FROM must use a verified sending domain,
# for example: iTeach <no-reply@example.com>
RESEND_API_KEY=
RESEND_FROM=

# Firebase service account key for push notifications (FCM).
# Base64 is recommended — the raw JSON contains newlines inside private_key
# that most .env parsers mangle:
#   base64 -i service-account.json | tr -d '\n'
# Raw JSON on a single line also works. Unset means push is skipped (logged).
GOOGLE_SERVICES_JSON=

# Shared secret for the external API (/api/external/*), sent as the X-Auth header.
# Generate with: openssl rand -base64 32
EXTERNAL_API_KEY=

# Optional. Per-IP hourly cap on OTP sends; leave empty to disable.
# Only enable behind a reverse proxy once `trust proxy` is configured,
# otherwise every request looks like one IP and real users get blocked.
OTP_MAX_PER_IP_PER_HOUR=
