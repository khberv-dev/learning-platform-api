PORT=8000

JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRE=1h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRE=7d

DB_HOST=
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore
GEMINI_PROXY_URL=

CLICK_SERVICE_ID=
CLICK_SECRET_KEY=

ESKIZ_API_URL=https://notify.eskiz.uz/api
ESKIZ_API_USER=
ESKIZ_API_KEY=

# Shared secret for the external API (/api/external/*), sent as the X-Auth header.
# Generate with: openssl rand -base64 32
EXTERNAL_API_KEY=

# Optional. Per-IP hourly cap on OTP sends; leave empty to disable.
# Only enable behind a reverse proxy once `trust proxy` is configured,
# otherwise every request looks like one IP and real users get blocked.
OTP_MAX_PER_IP_PER_HOUR=
