# HTTP port
PORT=8000

# DEVELOPMENT or DEPLOYMENT
ENVIRONMENT=DEVELOPMENT

# Access token signing secret and lifetime
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRE=1h
# Refresh token signing secret and lifetime
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRE=7d

# PostgreSQL connection
DB_HOST=
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=

# AssemblyAI key for speech-to-text in the student app
ASSEMBLYAI_API_KEY=

# Click payment merchant credentials
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=

# Payme merchant key
PAYME_MERCHANT_KEY=
# Payme account field name
PAYME_ACCOUNT_FIELD=payment_id

# Eskiz SMS gateway
ESKIZ_API_URL=https://notify.eskiz.uz/api
ESKIZ_API_USER=
ESKIZ_API_KEY=

# Resend email gateway and verified sender
RESEND_API_KEY=
RESEND_FROM=

# Firebase service account (base64 JSON) for push notifications
GOOGLE_SERVICES_JSON=

# Google Cloud Storage service account (base64 JSON) for file storage
GOOGLE_CLOUD_STORAGE_JSON=

# Shared secret for the external API (X-Auth header)
EXTERNAL_API_KEY=

# Per-IP hourly OTP send limit, empty to disable
OTP_MAX_PER_IP_PER_HOUR=
